{
    "compilerOptions": {
        "target": "ES6",
        "module": "ES6",
        "outDir": "./assets/dist",
        "rootDir": "./assets",
        "strict": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["./assets/**/*.ts"],
    "exclude": ["node_modules"]
}